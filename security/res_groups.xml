<odoo>
    <!-- Categoría primero -->
    <record id="module_category_maquinados_admin" model="ir.module.category">
        <field name="name">Maquinados</field>
        <field name="description">Da permisos de administrador para modulo de maquinados</field>
        <field name="sequence">52</field>
    </record>

    <!-- Grupo admin -->
    <record id="group_maquinados_admin" model="res.groups">
        <field name="name">Maquinados Administración</field>
        <field name="category_id" ref="module_category_maquinados_admin"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>      

    <record id="group_maquinados_user" model="res.groups">
        <field name="name">Maquinados Usuario</field>
        <field name="category_id" ref="module_category_maquinados_admin"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>      

    <record id="group_maquinados_restriccion" model="res.groups">
        <field name="name">Maquinados Restriccion</field>
        <field name="category_id" ref="module_category_maquinados_admin"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>      
</odoo>
